# Copy to .env and edit.
# Default (when .env is absent) is set in useApi.js.

# Android emulator → the host PC's loopback:
EXPO_PUBLIC_API_URL=http://10.0.2.2:8000

# Physical phone on the same WiFi (use your PC's LAN IP, e.g. ipconfig getifaddr en0):
# EXPO_PUBLIC_API_URL=http://192.168.1.98:8000

# Cloudflare quick tunnel (start_backend.ps1 prints a fresh one every restart,
# so this value must be pasted again after each restart):
# EXPO_PUBLIC_API_URL=https://<printed-url>.trycloudflare.com

# Requires a backend that serves /auth/* — run
# https://github.com/RegShadbhav041/PotatoDoc-Backend