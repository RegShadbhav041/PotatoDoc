# Copy to .env and edit.
# Primary (public tunnel) + local fallback — the app tries them in order and
# remembers whichever answers (see API_CANDIDATES in src/hooks/useApi.js).
# Defaults (when .env is absent) are set in useApi.js.

# Cloudflare quick tunnel (start_backend.ps1 prints a fresh one every restart,
# so this value must be pasted again after each restart):
EXPO_PUBLIC_API_URL=https://<printed-url>.trycloudflare.com

# Local fallback — same backend without the tunnel:
# Android emulator → the host PC's loopback:
EXPO_PUBLIC_LOCAL_URL=http://10.0.2.2:8000

# Physical phone on the same WiFi (use your PC's LAN IP):
# EXPO_PUBLIC_LOCAL_URL=http://192.168.1.65:8000

# Requires a backend that serves /auth/* — run
# https://github.com/RegShadbhav041/PotatoDoc-Backend